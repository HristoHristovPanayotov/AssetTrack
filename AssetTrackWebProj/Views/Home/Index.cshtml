@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Asset Management Dashboard</h1>
        <p class="text-muted mb-0">A live snapshot of your corporate hardware estate.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card metric-card text-bg-primary shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small">Total Assets</div>
                    <div class="metric-value">@Model.TotalAssets</div>
                </div>
                <i class="bi bi-pc-display metric-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card metric-card text-bg-warning shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small">Open Tickets</div>
                    <div class="metric-value">@Model.OpenTickets</div>
                </div>
                <i class="bi bi-tools metric-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card metric-card text-bg-success shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small">Total Equipment Value</div>
                    <div class="metric-value">@Model.TotalInventoryValue.ToString("C0")</div>
                </div>
                <i class="bi bi-cash-stack metric-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Quick Actions</div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @if (User.IsInRole(SeedConstants.AdministratorRoleName))
                    {
                        <a class="btn btn-primary" asp-controller="Assets" asp-action="Create">
                            <i class="bi bi-plus-circle"></i> Register Asset
                        </a>
                        <a class="btn btn-outline-primary" asp-controller="Assets" asp-action="Index">
                            <i class="bi bi-list-ul"></i> Master Inventory
                        </a>
                        <a class="btn btn-outline-secondary" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-tags"></i> Manage Categories
                        </a>
                        <a class="btn btn-outline-warning" asp-controller="Tickets" asp-action="Open">
                            <i class="bi bi-tools"></i> Process Tickets
                        </a>
                    }
                    else if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a class="btn btn-primary" asp-controller="Assets" asp-action="MyGear">
                            <i class="bi bi-bag-check"></i> My Assigned Gear
                        </a>
                        <a class="btn btn-outline-danger" asp-controller="Tickets" asp-action="Create">
                            <i class="bi bi-exclamation-octagon"></i> Report a Problem
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">
                            Create an account
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Maintenance Spend</div>
            <div class="card-body d-flex flex-column justify-content-center text-center">
                <div class="display-6 fw-bold text-danger">@Model.TotalRepairSpend.ToString("C2")</div>
                <div class="text-muted small">Total recorded repair expenditure</div>
            </div>
        </div>
    </div>
</div>
