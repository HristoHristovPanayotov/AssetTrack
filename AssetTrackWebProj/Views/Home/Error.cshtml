@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-7">
        <div class="error-hero text-primary mb-2">@Model.StatusCode</div>
        <h1 class="h3 mb-3">@Model.Title</h1>
        <p class="text-muted">@Model.Message</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }

        <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Back to Dashboard
        </a>
    </div>
</div>
