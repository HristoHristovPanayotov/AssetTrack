@model IEnumerable<TicketViewModel>
@{
    ViewData["Title"] = "Open Tickets";
}

<h1 class="h3 mb-3">Open Maintenance Queue</h1>

@if (!Model.Any())
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> There are no open maintenance tickets. All clear!
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Reported</th>
                        <th>Asset</th>
                        <th>Description</th>
                        <th style="width: 320px;">Resolve</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@ticket.DateReported.ToString("d MMM yyyy")</td>
                            <td>
                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@ticket.AssetId">
                                    Asset #@ticket.AssetId
                                </a>
                            </td>
                            <td>@ticket.Description</td>
                            <td>
                                <form asp-action="Resolve" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@ticket.Id" />
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input type="number" name="repairCost" class="form-control"
                                               step="0.01" min="0" value="0" required
                                               aria-label="Repair cost" />
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-success text-nowrap">
                                        <i class="bi bi-check-lg"></i> Resolve
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
