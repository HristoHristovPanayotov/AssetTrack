@model AssetDetailsViewModel
@{
    ViewData["Title"] = "Asset Details";
    var isAdmin = User.IsInRole(SeedConstants.AdministratorRoleName);

    string StatusClass(AssetStatus s) => s switch
    {
        AssetStatus.Available => "bg-success",
        AssetStatus.Assigned => "bg-primary",
        AssetStatus.UnderMaintenance => "bg-warning text-dark",
        AssetStatus.Retired => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to Inventory
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Specifications</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Serial Number</dt>
                    <dd class="col-7"><code>@Model.SerialNumber</code></dd>

                    <dt class="col-5">Model</dt>
                    <dd class="col-7">@Model.Model</dd>

                    <dt class="col-5">Category</dt>
                    <dd class="col-7">@Model.CategoryName</dd>

                    <dt class="col-5">Purchase Date</dt>
                    <dd class="col-7">@Model.PurchaseDate.ToString("d MMM yyyy")</dd>

                    <dt class="col-5">Value</dt>
                    <dd class="col-7">@Model.Value.ToString("C2")</dd>

                    <dt class="col-5">Status</dt>
                    <dd class="col-7">
                        <span class="badge status-badge @StatusClass(Model.Status)">@Model.Status</span>
                    </dd>

                    <dt class="col-5">Assigned To</dt>
                    <dd class="col-7">@(Model.AssignedUserName ?? "Unassigned")</dd>
                </dl>
            </div>
            @if (isAdmin)
            {
                <div class="card-footer d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Repair &amp; Maintenance Logs</span>
                <a class="btn btn-sm btn-outline-warning" asp-controller="Tickets" asp-action="Create">
                    <i class="bi bi-tools"></i> Report Issue
                </a>
            </div>
            <div class="card-body">
                <!-- Populated asynchronously via fetch() against the Web API controller. -->
                <div id="ticketsLoading" class="text-muted py-3">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Loading maintenance history&hellip;
                </div>
                <div id="ticketsError" class="alert alert-danger d-none" role="alert"></div>
                <div class="table-responsive d-none" id="ticketsWrapper">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Reported</th>
                                <th>Description</th>
                                <th class="text-end">Cost</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="ticketsBody"></tbody>
                    </table>
                </div>
                <p id="ticketsEmpty" class="text-muted mb-0 d-none">
                    No maintenance tickets have been filed for this asset.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // AJAX integration (mandatory): pull repair logs from the Web API
        // endpoint GET /api/maintenance/{assetId} without a full page reload.
        (function () {
            const assetId = @Model.Id;
            const loading = document.getElementById('ticketsLoading');
            const errorBox = document.getElementById('ticketsError');
            const wrapper = document.getElementById('ticketsWrapper');
            const body = document.getElementById('ticketsBody');
            const empty = document.getElementById('ticketsEmpty');

            const money = new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' });

            function fmtDate(value) {
                const d = new Date(value);
                return isNaN(d) ? value : d.toLocaleDateString();
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text ?? '';
                return div.innerHTML;
            }

            fetch('/api/maintenance/' + assetId, {
                headers: { 'Accept': 'application/json' }
            })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('Request failed with status ' + resp.status);
                    return resp.json();
                })
                .then(function (tickets) {
                    loading.classList.add('d-none');

                    if (!Array.isArray(tickets) || tickets.length === 0) {
                        empty.classList.remove('d-none');
                        return;
                    }

                    tickets.forEach(function (t) {
                        const tr = document.createElement('tr');
                        const statusBadge = t.isResolved
                            ? '<span class="badge bg-success">Resolved</span>'
                            : '<span class="badge bg-warning text-dark">Open</span>';
                        tr.innerHTML =
                            '<td>' + fmtDate(t.dateReported) + '</td>' +
                            '<td>' + escapeHtml(t.description) + '</td>' +
                            '<td class="text-end">' + money.format(t.repairCost ?? 0) + '</td>' +
                            '<td>' + statusBadge + '</td>';
                        body.appendChild(tr);
                    });

                    wrapper.classList.remove('d-none');
                })
                .catch(function (err) {
                    loading.classList.add('d-none');
                    errorBox.textContent = 'Could not load maintenance logs: ' + err.message;
                    errorBox.classList.remove('d-none');
                });
        })();
    </script>
}
