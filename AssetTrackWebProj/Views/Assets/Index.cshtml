@model AssetIndexViewModel
@{
    ViewData["Title"] = "Master Inventory";
    var isAdmin = User.IsInRole(SeedConstants.AdministratorRoleName);

    string StatusClass(AssetStatus s) => s switch
    {
        AssetStatus.Available => "bg-success",
        AssetStatus.Assigned => "bg-primary",
        AssetStatus.UnderMaintenance => "bg-warning text-dark",
        AssetStatus.Retired => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Master Inventory</h1>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Register Asset
        </a>
    }
</div>

<form method="get" asp-action="Index" id="searchForm" class="mb-3">
    <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" name="search" id="searchBox" class="form-control"
               placeholder="Live search by name or serial number..."
               value="@Model.SearchTerm" autocomplete="off" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a class="sort-link" asp-action="Index"
                           asp-route-sortOrder="@Model.NameSortParam"
                           asp-route-search="@Model.SearchTerm">
                            Name <i class="bi bi-arrow-down-up small"></i>
                        </a>
                    </th>
                    <th>
                        <a class="sort-link" asp-action="Index"
                           asp-route-sortOrder="@Model.SerialSortParam"
                           asp-route-search="@Model.SearchTerm">
                            Serial # <i class="bi bi-arrow-down-up small"></i>
                        </a>
                    </th>
                    <th>Category</th>
                    <th>Assigned To</th>
                    <th class="text-end">
                        <a class="sort-link" asp-action="Index"
                           asp-route-sortOrder="@Model.ValueSortParam"
                           asp-route-search="@Model.SearchTerm">
                            Value <i class="bi bi-arrow-down-up small"></i>
                        </a>
                    </th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Assets.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No assets found.</td>
                    </tr>
                }
                @foreach (var asset in Model.Assets.Items)
                {
                    <tr>
                        <td class="fw-semibold">@asset.Name</td>
                        <td><code>@asset.SerialNumber</code></td>
                        <td>@asset.CategoryName</td>
                        <td>@(asset.AssignedUserName ?? "—")</td>
                        <td class="text-end">@asset.Value.ToString("C2")</td>
                        <td>
                            <span class="badge status-badge @StatusClass(asset.Status)">
                                @asset.Status
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Details" asp-route-id="@asset.Id">Details</a>
                            @if (isAdmin)
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Edit" asp-route-id="@asset.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger"
                                   asp-action="Delete" asp-route-id="@asset.Id">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Assets.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Assets.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Assets.PageIndex - 1)"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-search="@Model.SearchTerm">Previous</a>
            </li>
            @for (var i = 1; i <= Model.Assets.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Assets.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-search="@Model.SearchTerm">@i</a>
                </li>
            }
            <li class="page-item @(Model.Assets.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Assets.PageIndex + 1)"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-search="@Model.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        // Debounced "live" search: auto-submits the filter form as the user types.
        (function () {
            const box = document.getElementById('searchBox');
            const form = document.getElementById('searchForm');
            let timer = null;
            if (!box || !form) return;
            box.addEventListener('keyup', function (e) {
                if (e.key === 'Enter') return;
                clearTimeout(timer);
                timer = setTimeout(function () { form.submit(); }, 450);
            });
        })();
    </script>
}
